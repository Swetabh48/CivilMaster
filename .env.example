DATABASE_URL=sqlite:///./data/civilmaster.db
# For Postgres + pgvector (Docker):
# DATABASE_URL=postgresql+psycopg://civilmaster:civilmaster_dev@localhost:5432/civilmaster
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=./data/uploads
CORPUS_DIR=./data/corpus
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# QLoRA adapter from Colab (Qwen2.5-3B). Used when CUDA + peft/transformers are installed.
LORA_ADAPTER_PATH=./training/adapters/civilmaster-lora
OCR_ENABLED=true
OCR_MAX_PAGES=40
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MAX_UPLOAD_MB=20
ADMIN_EMAIL=admin@example.com
FEEDBACK_EXPORT_PATH=./training/datasets/approved_feedback.jsonl
